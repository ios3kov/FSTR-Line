{
  "name": "fstr-line-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:host": "node scripts/check-extend-script.mjs",
    "build:cep": "npm run build && npm run check:host && esbuild src/cep/client-entry.ts --bundle --format=iife --platform=browser --outfile=cep/client/app.js && node scripts/build-cep.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run build && npm test",
    "check:cep": "npm run build:cep"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
